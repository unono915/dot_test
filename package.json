{
  "name": "school-asset-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "오프라인 학교 정보자산 관리",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "start": "npm run build && electron .",
    "test:unit": "tsc -p tsconfig.main.json && vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check:sqlite:node": "node --test tests/toolchain/sqlite-smoke.cjs",
    "check:sqlite:electron": "node scripts/check-electron-sqlite.cjs"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "exceljs": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
